# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CONTACT_RECEIVER_EMAIL: The email address where form submissions should go.
# Defaults to your email (adamkassimdusman@gmail.com) if not specified.
CONTACT_RECEIVER_EMAIL="adamkassimdusman@gmail.com"

# SMTP Configuration: Required to authenticate and send the emails.
# e.g., smtp.gmail.com for Gmail, smtp.sendgrid.net for SendGrid, etc.
SMTP_HOST="smtp.gmail.com"
# e.g., 465 (SSL) or 587 (TLS/STARTTLS)
SMTP_PORT="587"
# Your SMTP username / sending email address
SMTP_USER="my-sending-email@gmail.com"
# Your SMTP password / app password
SMTP_PASS="my-smtp-password-or-app-password"
